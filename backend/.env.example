# ==============================================================
# ROVIN V1.0 PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Environment
PORT=5050
NODE_ENV=production

# Frontend Client URL(s) - Comma-separated if multiple (Vercel production & preview domains)
CLIENT_URL=https://rovin.vercel.app,http://localhost:5173

# Database (Neon Serverless PostgreSQL - neon.tech)
# Example: postgresql://[user]:[password]@[endpoint].ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
JWT_SECRET=rovin_production_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Email / OTP Provider (RECOMMENDED: Resend at resend.com or Gmail SMTP)
# Mode: EMAIL (production) or CONSOLE (development mock)
OTP_PROVIDER=EMAIL

# Resend SMTP Configuration (resend.com):
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
EMAIL_FROM="ROVIN Tactical <onboarding@resend.dev>"

# Cloudinary Media Storage (cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Courier Gateways (Optional: Cash on Delivery works automatically without these)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=

